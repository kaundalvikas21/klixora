# ---------------------------------------------------------------------------
# Supabase
#
# Local development needs no cloud project and no Docker:
#
#   npm run db:start     brings the stack up on the native runtime
#   npm run db:reset     applies supabase/migrations and supabase/seed.sql
#   npm run db:admin     creates the admin operator from the values below
#
# `npx supabase status` prints these values again at any time. The local keys
# are fixed development values, identical on every machine, so they are not
# secrets. The hosted ones are: never commit a real service role key.
#
# Against a hosted project, use its URL and keys instead and push the same
# migrations with `npm run db:push`.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Either name works. `supabase status` prints PUBLISHABLE_KEY on current CLI
# versions and ANON_KEY on older ones; they are the same key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# ---------------------------------------------------------------------------
# The admin operator, created by `npm run db:admin`. Re-running resets the
# password, which is the recovery path when it is forgotten.
#
#   npm run db:admin -- --only    makes ADMIN_EMAIL the ONLY admin, revoking
#                                 every other account.
#
# Quote the password if it contains a '#'. Unquoted, dotenv treats the rest
# of the line as a comment and you get a silently truncated password.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@klixora.site
ADMIN_PASSWORD=
ADMIN_NAME="Klixora Admin"

# ---------------------------------------------------------------------------
# Canonical origin. Used for metadataBase, robots.txt and the sitemap.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://klixora.site

# ---------------------------------------------------------------------------
# Lead notification email (Resend). Unset and new leads are still stored, the
# notification is just skipped and logged.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
LEAD_NOTIFY_FROM=
LEAD_NOTIFY_TO=

# Set to "noindex" on any deploy that is not production (staging, previews).
# netlify.toml already does this for deploy-preview and branch-deploy.
NEXT_PUBLIC_ROBOTS=
