# Lead capture. Leave unset and the enquiry form validates but does not save,
# telling visitors to email instead. Fill these in to switch storage on.
#
# The form writes to the `leads` table, which already carries an
# "Anyone can submit a lead" INSERT policy and admin-only SELECT — so the
# publishable key here cannot read anyone's submissions.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
